# Cell 1: Environment Setup
import sys
sys.path.append('../')

import pandas as pd
import numpy as np
from datetime import datetime
import logging

from src.data.collector import EPMDataCollector, SP500_TOP100

logging.basicConfig(level=logging.INFO)

# Cell 2: Initialize Collector
tickers = SP500_TOP100[:50]

collector = EPMDataCollector(
    tickers=tickers,
    data_dir='../data/raw'
)

# Cell 3: Execute Data Collection
data = collector.collect_all(rate_limit=0.5, verbose=True)

# Cell 4: Collection Statistics
stats = collector.get_collection_stats()

print("\n" + "="*60)
print("DATA COLLECTION STATISTICS")
print("="*60)
for key, value in stats.items():
    print(f"{key:30s}: {value}")
print("="*60)

# Cell 5: Save Data
collector.save('epm_sp500_top50.pkl')
collector.save_csv()

# Cell 6: Quick Data Inspection
sample_ticker = list(data.keys())[0]
sample_data = data[sample_ticker]

print(f"\nSample Data for {sample_ticker}:")
print(f"Sector: {sample_data['info']['sector']}")
print(f"Industry: {sample_data['info']['industry']}")
print(f"\nEarnings Estimate:")
print(sample_data['earnings_estimate'])
print(f"\nEarnings History (last 5):")
print(sample_data['earnings_history'].head())

# Cell 7: Analyze Estimate Coverage
coverage_data = []

for ticker, ticker_data in data.items():
    has_estimate = ticker_data['earnings_estimate'] is not None
    has_history = ticker_data['earnings_history'] is not None and not ticker_data['earnings_history'].empty
    
    coverage_data.append({
        'ticker': ticker,
        'sector': ticker_data['info']['sector'],
        'has_estimate': has_estimate,
        'has_history': has_history
    })

coverage_df = pd.DataFrame(coverage_data)

print("\nCoverage by Sector:")
print(coverage_df.groupby('sector').agg({
    'has_estimate': 'sum',
    'has_history': 'sum',
    'ticker': 'count'
}).rename(columns={'ticker': 'total_count'}))

# Cell 8: Estimate Quality Check
for ticker in list(data.keys())[:10]:
    ticker_data = data[ticker]
    
    if ticker_data['earnings_estimate'] is not None:
        est_df = ticker_data['earnings_estimate']
        print(f"\n{ticker}:")
        print(f"  Current Quarter Estimate: {est_df.iloc[0, 0] if len(est_df) > 0 else 'N/A'}")
        print(f"  Estimate Shape: {est_df.shape}")

