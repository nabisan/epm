# Cell 1: Load Data
import sys
sys.path.append('../')

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from pathlib import Path

from src.data.collector import EPMDataCollector

data_path = Path('../data/raw/epm_sp500_top50.pkl')
data, errors, metadata = EPMDataCollector.load(data_path)

print(f"Loaded data for {len(data)} tickers")
print(f"Errors: {len(errors)}")

# Cell 2: Aggregate Estimates Analysis
all_estimates = []

for ticker, ticker_data in data.items():
    if ticker_data['earnings_estimate'] is not None:
        est_df = ticker_data['earnings_estimate'].copy()
        est_df['ticker'] = ticker
        est_df['sector'] = ticker_data['info']['sector']
        all_estimates.append(est_df)

if all_estimates:
    estimates_df = pd.concat(all_estimates, ignore_index=True)
    print(f"\nTotal estimate records: {len(estimates_df)}")
    print(f"\nEstimates DataFrame columns:")
    print(estimates_df.columns.tolist())
    print(f"\nSample:")
    print(estimates_df.head(10))

# Cell 3: Earnings History Analysis
all_actuals = []

for ticker, ticker_data in data.items():
    if ticker_data['earnings_history'] is not None and not ticker_data['earnings_history'].empty:
        act_df = ticker_data['earnings_history'].copy()
        act_df['ticker'] = ticker
        act_df['sector'] = ticker_data['info']['sector']
        all_actuals.append(act_df)

if all_actuals:
    actuals_df = pd.concat(all_actuals, ignore_index=True)
    print(f"\nTotal actual earnings records: {len(actuals_df)}")
    print(f"\nActuals DataFrame columns:")
    print(actuals_df.columns.tolist())

# Cell 4: Calculate Consensus vs Actual Errors
if 'EPS Estimate' in actuals_df.columns and 'Reported EPS' in actuals_df.columns:
    actuals_df['consensus_error'] = abs(actuals_df['Reported EPS'] - actuals_df['EPS Estimate'])
    actuals_df['surprise_pct'] = (actuals_df['Reported EPS'] - actuals_df['EPS Estimate']) / abs(actuals_df['EPS Estimate']) * 100
    
    print("\nConsensus Forecast Accuracy:")
    print(f"Mean Absolute Error: {actuals_df['consensus_error'].mean():.4f}")
    print(f"Median Absolute Error: {actuals_df['consensus_error'].median():.4f}")
    print(f"Mean Surprise %: {actuals_df['surprise_pct'].mean():.2f}%")

# Cell 5: Sector-Level Analysis
if all_estimates and 'sector' in estimates_df.columns:
    sector_stats = estimates_df.groupby('sector').size().sort_values(ascending=False)
    
    print("\nEstimate Coverage by Sector:")
    print(sector_stats)
    
    plt.figure(figsize=(12, 6))
    sector_stats.plot(kind='barh')
    plt.xlabel('Number of Estimates')
    plt.title('Analyst Estimate Coverage by Sector')
    plt.tight_layout()
    plt.show()

# Cell 6: Temporal Distribution
if all_actuals:
    actuals_df['report_date'] = pd.to_datetime(actuals_df.index)
    actuals_df['year'] = actuals_df['report_date'].dt.year
    actuals_df['quarter'] = actuals_df['report_date'].dt.quarter
    
    temporal_dist = actuals_df.groupby(['year', 'quarter']).size()
    
    print("\nTemporal Distribution of Earnings Reports:")
    print(temporal_dist.tail(12))

